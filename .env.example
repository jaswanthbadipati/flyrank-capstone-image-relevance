# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///data/database.sqlite3

# AI Model Configuration
# Provider options: "offline" (free local simulation) or "gemini" (Google AI Studio free tier)
AI_PROVIDER=offline
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Mismatch Guard Thresholds
MIN_CONFIDENCE_THRESHOLD=0.70
MIN_SIMILARITY_THRESHOLD=0.60
CONFIDENT_SIMILARITY_THRESHOLD=0.75

# Batch Job Configuration
MAX_BATCH_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
